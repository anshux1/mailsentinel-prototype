# Shared local defaults; copy app-specific examples into each runtime.
APP_ENV=development
DATABASE_URL=postgresql://mailsentinel:mailsentinel@localhost:5432/mailsentinel
REDIS_URL=redis://localhost:6379/0
BETTER_AUTH_SECRET=local-development-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
ANALYZER_INTERNAL_URL=http://analyzer:8000
ANALYZER_SERVICE_TOKEN=local-development-token-change-me
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mailsentinel-evidence
S3_ACCESS_KEY_ID=mailsentinel
S3_SECRET_ACCESS_KEY=mailsentinel-local-secret
S3_FORCE_PATH_STYLE=true
MAX_EML_BYTES=26214400
WEB_DATA_MODE=fixture
MAX_CONTAINER_MESSAGES=500
MAX_CONTAINER_BYTES=104857600
MAX_NESTED_MESSAGE_DEPTH=3
MAX_NESTED_MESSAGES=10
MAX_MIME_PARTS=200
MAX_MIME_DEPTH=30
MAX_HEADER_COUNT=1000
MAX_URLS=500
MAX_ATTACHMENT_BYTES=10485760
EXECUTION_TIMEOUT_SECONDS=120
ANALYSIS_VERSION=prototype-1
RETENTION_DAYS=90

# --- Analyzer Enrichment & Threat Intelligence ---
# Modes: fixture (default, offline & safe), offline (local GeoIP/reputation files), live (AbuseIPDB)
ENRICHMENT_MODE=fixture
ENRICHMENT_MAX_REQUESTS=10
ENRICHMENT_CACHE_TTL_SECONDS=86400
ENRICHMENT_LIVE_CACHE_TTL_SECONDS=3600
ENRICHMENT_CONNECT_TIMEOUT_SECONDS=2
ENRICHMENT_READ_TIMEOUT_SECONDS=3
MAXMIND_DB_PATH=
OFFLINE_REPUTATION_PATH=
ABUSEIPDB_API_KEY=

MAILBOX_CONNECTORS_ENABLED=false
MAILBOX_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-characters-for-mailbox-crypto
GOOGLE_OAUTH_CLIENT_ID=optional-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=optional-google-client-secret
MAILBOX_SYNC_MAX_MESSAGES=200

# --- Docker Compose & Local Infrastructure ---
# Web port and loopback binding (loopback ensures exposure only via Cloudflare Tunnel)
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Backing service credentials and host port bindings
POSTGRES_USER=mailsentinel
POSTGRES_PASSWORD=mailsentinel
POSTGRES_DB=mailsentinel
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Initial demo identity seeded on first startup
DEMO_USER_EMAIL=demo@mailsentinel.local
DEMO_USER_PASSWORD=MailSentinel-Demo-2026!

# Cloudflare Tunnel (optional token for stable named tunnel via --profile cloudflare-tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
