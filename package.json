{
	"name": "mailsentinel",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --parallel",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "turbo run format",
		"clean": "turbo run clean && node scripts/clean.mjs",
		"db:generate": "pnpm --filter @mailsentinel/db db:generate",
		"db:migrate": "pnpm --filter @mailsentinel/db db:migrate",
		"db:seed": "pnpm --filter @mailsentinel/auth db:seed",
		"contracts:generate": "pnpm --filter @mailsentinel/analyzer contracts:export && pnpm --filter @mailsentinel/contracts generate",
		"contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/generated",
		"env:check": "node scripts/check-env-docs.mjs",
		"infra:start": "./infra/scripts/start.sh",
		"infra:wait": "./infra/scripts/wait.sh",
		"infra:reset": "./infra/scripts/reset.sh",
		"infra:stop": "./infra/scripts/stop.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"prettier": "^3.6.2",
		"turbo": "^2.10.12",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=22 <23"
	},
	"pnpm": {
		"overrides": {
			"esbuild@<=0.24.2": "0.25.12",
			"nanoid@<3.3.18": "3.3.18"
		}
	}
}
