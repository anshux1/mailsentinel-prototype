            "default": null,
            "title": "Displayname"
          },
          "domain": {
            "anyOf": [
              {
                "maxLength": 253,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Domain"
          },
          "source": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "value": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value",
          "source"
        ],
        "title": "AddressObservation",
        "type": "object"
      },
      "AnalysisFailure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/AnalysisFailureCode"
