{
	"components": {
		"schemas": {
			"AnalysisIntakeAccepted": {
				"properties": {
					"analysis_run_id": {
						"title": "Analysis Run Id",
						"type": "string"
					},
					"status": {
						"$ref": "#/components/schemas/AnalysisStatusValue",
						"default": "accepted"
					}
				},
				"required": ["analysis_run_id"],
				"title": "AnalysisIntakeAccepted",
				"type": "object"
			},
			"AnalysisIntakeRequest": {
				"properties": {
					"analysis_run_id": {
						"minLength": 1,
						"title": "Analysis Run Id",
						"type": "string"
					},
					"artifact": {
						"$ref": "#/components/schemas/Artifact"
					},
					"case_id": {
						"minLength": 1,
						"title": "Case Id",
						"type": "string"
					},
					"organization_id": {
						"minLength": 1,
						"title": "Organization Id",
						"type": "string"
					},
					"requested_at": {
						"format": "date-time",
						"title": "Requested At",
						"type": "string"
					}
				},
				"required": ["case_id", "organization_id", "analysis_run_id", "artifact", "requested_at"],
				"title": "AnalysisIntakeRequest",
				"type": "object"
			},
			"AnalysisStatusValue": {
				"enum": ["accepted", "queued", "deferred", "failed"],
				"title": "AnalysisStatusValue",
				"type": "string"
			},
			"Artifact": {
				"properties": {
					"byte_size": {
						"exclusiveMinimum": 0,
						"title": "Byte Size",
						"type": "integer"
					},
					"object_key": {
						"pattern": "^organizations/[^/]+/cases/[^/]+/artifacts/.+",
						"title": "Object Key",
						"type": "string"
					},
					"sha256": {
						"maxLength": 64,
						"minLength": 64,
						"title": "Sha256",
						"type": "string"
					}
				},
				"required": ["object_key", "sha256", "byte_size"],
				"title": "Artifact",
				"type": "object"
			},
			"HTTPValidationError": {
				"properties": {
					"detail": {
						"items": {
							"$ref": "#/components/schemas/ValidationError"
						},
						"title": "Detail",
						"type": "array"
					}
				},
				"title": "HTTPValidationError",
				"type": "object"
			},
			"ValidationError": {
				"properties": {
					"ctx": {
						"title": "Context",
						"type": "object"
					},
					"input": {
						"title": "Input"
					},
					"loc": {
						"items": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "integer"
								}
							]
						},
						"title": "Location",
						"type": "array"
					},
					"msg": {
						"title": "Message",
						"type": "string"
					},
					"type": {
						"title": "Error Type",
						"type": "string"
					}
				},
				"required": ["loc", "msg", "type"],
				"title": "ValidationError",
				"type": "object"
			}
		}
	},
	"info": {
		"title": "MailSentinel Analyzer",
		"version": "prototype-1"
	},
	"openapi": "3.1.0",
	"paths": {
		"/health/live": {
			"get": {
				"operationId": "live_health_live_get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {
										"type": "boolean"
									},
									"title": "Response Live Health Live Get",
									"type": "object"
								}
							}
						},
						"description": "Successful Response"
					}
				},
				"summary": "Live"
			}
		},
		"/health/ready": {
			"get": {
				"operationId": "ready_health_ready_get",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {
										"type": "string"
									},
									"title": "Response Ready Health Ready Get",
									"type": "object"
								}
							}
						},
						"description": "Successful Response"
					}
				},
				"summary": "Ready"
			}
		},
		"/v1/analyses": {
			"post": {
				"operationId": "intake_v1_analyses_post",
				"parameters": [
					{
						"in": "header",
						"name": "authorization",
						"required": false,
						"schema": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							],
							"title": "Authorization"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/AnalysisIntakeRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"202": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AnalysisIntakeAccepted"
								}
							}
						},
						"description": "Successful Response"
					},
					"422": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HTTPValidationError"
								}
							}
						},
						"description": "Validation Error"
					}
				},
				"summary": "Intake"
			}
		}
	}
}
