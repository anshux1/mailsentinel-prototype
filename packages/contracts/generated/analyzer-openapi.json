        "title": "AnalysisFailure",
        "type": "object"
      },
      "AnalysisFailureCode": {
        "enum": [
          "intake_invalid",
          "evidence_not_found",
          "evidence_too_large",
          "evidence_digest_mismatch",
          "evidence_size_mismatch",
          "evidence_storage_unavailable",
          "message_invalid",
          "header_limit_exceeded",
          "mime_limit_exceeded",
          "attachment_limit_exceeded",
          "analysis_run_not_found",
          "analysis_failed",
          "internal_error"
