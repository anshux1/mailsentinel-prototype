        "title": "AnalysisFailureCode",
        "type": "string"
      },
      "AnalysisIntakeAccepted": {
        "additionalProperties": false,
        "properties": {
          "analysisRunId": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Analysisrunid",
