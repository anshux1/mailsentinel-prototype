{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"ANALYZER_INTERNAL_URL",
		"ANALYZER_SERVICE_TOKEN",
		"S3_ENDPOINT",
		"S3_REGION",
		"S3_BUCKET",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_FORCE_PATH_STYLE",
		"MAX_EML_BYTES",
		"APP_ENV",
		"WEB_DATA_MODE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*", "pnpm-lock.yaml", "pyproject.toml", "uv.lock", "migrations/**"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] },
		"format": {},
		"clean": { "cache": false },
		"contracts:generate": { "dependsOn": ["^contracts:generate"], "outputs": ["generated/**"] },
		"db:generate": { "cache": false },
		"db:migrate": { "cache": false },
		"db:seed": { "cache": false },
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
