DATABASE_URL=postgresql://mailsentinel:mailsentinel@localhost:5432/mailsentinel
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
ANALYZER_INTERNAL_URL=http://analyzer:8000
ANALYZER_SERVICE_TOKEN=local-development-token-change-me
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mailsentinel-evidence
S3_ACCESS_KEY_ID=mailsentinel
S3_SECRET_ACCESS_KEY=mailsentinel-local-secret
S3_FORCE_PATH_STYLE=true
MAX_EML_BYTES=26214400
MAX_CONTAINER_BYTES=104857600
APP_ENV=development
WEB_DATA_MODE=fixture
MAILBOX_CONNECTORS_ENABLED=false
MAILBOX_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-characters-for-mailbox-crypto
MAILBOX_SYNC_MAX_MESSAGES=200
GOOGLE_OAUTH_CLIENT_ID=optional-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=optional-google-client-secret
GMAIL_CLIENT_ID=optional-google-client-id
GMAIL_CLIENT_SECRET=optional-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/mailbox/gmail/callback
